    int16 formWeight4;

}SpecialForms; 

typedef struct //Rainy Chances are used during Rain Weather, I haven't tested all weathers
{
    byte NormalWeight;
    byte NormalWeightRainy;
    byte NormalLimit; 
    byte StrongWeight;
    byte StrongWeightRainy;
    byte StrongLimit;
    byte RareWeight;
    byte RareWeightRainy;
    int32 RareLimit;
    NormalForms NormalFormations;
    SpecialForms StrongFormations;
    SpecialForms RareFormations;
    NormalForms NormalFormationsRainy;
    SpecialForms StrongFormationsRainy;
    SpecialForms RareFormationsRainy;
}TSpawnWeight <read=rTSpawnWeight>;

string rTSpawnWeight(TSpawnWeight& e)
{
    string s;
    SPrintf(s, "%d/%d/%d -> %d/%d/%d Limit = %d/%d/%d", e.NormalWeight, e.StrongWeight, e.RareWeight, e.NormalWeightRainy, e.StrongWeightRainy, e.RareWeightRainy, e.NormalLimit, e.StrongLimit, e.RareLimit);
    return s;
}

typedef struct
{
    int16 Weight; //Adds up to 1000 typically across all items within a chest set
    Items itemID;
    int16 chestStatus; //0 is default, 1 is locked, 10 is used for special chests containing shadows, uncertain on other values
    byte itemQuantity; //1 in all but a single case
    byte chestSize; //0 for small, 1 for large
    int16 unkn3;
    int16 unkn4;
}ItemWeight<read=rItemWeight>;

string rItemWeight(ItemWeight& e)
{
    string s;
    string itemName = EnumToString(e.itemID);
    SPrintf(s, "%d %s %d %d %d %d %d", e.Weight, itemName, e.chestStatus, e.itemQuantity, e.chestSize, e.unkn3, e.unkn4);
    return s;
}

