// ENCOUNT.TBL

typedef struct
{
    b32 Flags <name = "Flags">;
    u16 Field04;
    u16 Field06;
    EnemiesID Units[ 5 ] <name = "Battle Units">;
    u16 FieldId <name = "Field ID">;
    u16 RoomId <name = "Room ID">;
    MusicID MusicId <name = "Music">;
} TEncounter <name = "Enemy Encounters">;

typedef struct
{
    byte spawnWeightID; //Determines the Shadow Spawn Weight Set used for the floor
    byte unkn1;
    byte unkn2; 
    byte unkn3;
    byte unkn4;
    byte unkn5;
    int32 chestWeightID; //Determines the Chest Weight Set used for the floor
}TFloorDetails <read=rTFloorDetails>; //Not sure how floor entries are chosen but they seem to be sequential for dungeons with empty floors skipped

string rTFloorDetails(TFloorDetails& e)
{
    string s;
    SPrintf(s, "%d - %d - %d - %d - %d - %d - %d", e.spawnWeightID, e.unkn1, e.unkn2, e.unkn3, e.unkn4, e.unkn5, e.chestWeightID);
    return s;
}

